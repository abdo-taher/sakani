# Root .htaccess for sakani.site domain routing
# This should be placed in the main domain root (/domains/sakani.site/public_html/)

RewriteEngine On

# Charset Configuration
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|php)$">
    Header set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 1. API Subdomain Routing
RewriteCond %{HTTP_HOST} ^api\.sakani\.site$ [NC]
RewriteCond %{REQUEST_URI} !^/sakani/
RewriteRule ^(.*)$ /sakani/backend/public/$1 [L]

# 2. Canonical www -> non-www 301 Redirect
RewriteCond %{HTTP_HOST} ^www\.sakani\.site$ [NC]
RewriteRule ^(.*)$ https://sakani.site/$1 [L,R=301]

# 3. Force HTTPS for main domain
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^sakani\.site$ [NC]
RewriteRule ^(.*)$ https://sakani.site/$1 [L,R=301]

# Main domain routing to frontend dist
RewriteCond %{HTTP_HOST} ^sakani\.site$ [NC]
RewriteCond %{REQUEST_URI} !^/sakani/
RewriteRule ^(.*)$ /sakani/frontend/dist/$1 [L]

# Handle missing files gracefully
ErrorDocument 404 /sakani/frontend/dist/index.html