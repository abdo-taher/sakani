# .htaccess Maintenance Mode Configuration for Sakani Frontend
# Rename this file to .htaccess in dist/ or public_html/ to activate static maintenance mode
# This serves maintenance.html with a 503 Service Unavailable status (SEO friendly)

RewriteEngine On

# 1. Allow static assets (CSS, JS, Images, Icons, Video) to load normally
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|mp4|webm)$ [NC]
RewriteRule ^ - [L]

# 2. Allow direct access to the maintenance page itself
RewriteCond %{REQUEST_URI} ^/maintenance\.html$ [NC]
RewriteRule ^ - [L]

# 3. Allow Admin portal and API access during maintenance
RewriteCond %{REQUEST_URI} ^/admin/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
RewriteCond %{HTTP_HOST} ^api\. [NC]
RewriteRule ^ - [L]

# 4. Optional: Whitelist specific developer IP addresses (uncomment and replace IP)
# RewriteCond %{REMOTE_ADDR} !^123\.456\.789\.000$

# 5. Serve maintenance.html for all other requests with 503 status
RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
RewriteRule ^(.*)$ /maintenance.html [R=503,L]

# Error document handler
ErrorDocument 503 /maintenance.html

# Prevent browser caching of the 503 response
<IfModule mod_headers.c>
    Header set Retry-After "3600"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</IfModule>
