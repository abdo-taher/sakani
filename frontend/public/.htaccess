# Sakani Production .htaccess Configuration
RewriteEngine On

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|php)$">
    Header set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 1. API Subdomain Handling (Preserve api.sakani.site without redirecting to root)
RewriteCond %{HTTP_HOST} ^api\.sakani\.site$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^api\.sakani\.site$ [NC]
RewriteRule ^(.*)$ backend/public/$1 [L]

# 2. Canonical www -> non-www 301 Direct Redirect (Single hop)
RewriteCond %{HTTP_HOST} ^www\.sakani\.site$ [NC]
RewriteRule ^(.*)$ https://sakani.site/$1 [L,R=301]

# 3. Force HTTPS for non-www domain
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^sakani\.site$ [NC]
RewriteRule ^(.*)$ https://sakani.site/$1 [L,R=301]

# Caching & Assets
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm|ogg|mov)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# If static pre-rendered directory with index.html exists, serve it
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# React Router SPA fallback for dynamic routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
